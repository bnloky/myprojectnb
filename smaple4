from functools import reduce
from delta.tables import DeltaTable
from pyspark.sql import functions as F

SOURCE_TABLES = {
    "Files/CBG_claims/": "Bronze.CBG_Claims_RawData",
    "Files/AMPS_Claims/": "Bronze.AMPS_Claims_RawData",
}

spark.sql("CREATE SCHEMA IF NOT EXISTS Bronze")


def ingest_to_bronze(source_path: str, target_table: str) -> None:

    # 1. Read pipe-delimited TXT files using their first row as headers.
    df = (
        spark.read
        .format("csv")
        .option("delimiter", "|")
        .option("header", "true")
        .option("inferSchema", "true")
        .option("enforceSchema", "false")
        .option("pathGlobFilter", "*.txt")
        .option("mode", "FAILFAST")
        .load(source_path)
    )

    if any(c.lower() == "loaddate" for c in df.columns):
        raise ValueError("Source already contains a LoadDate column.")

    source_columns = df.columns

    # 2. Remove duplicate source rows before adding the timestamp.
    df = df.dropDuplicates(source_columns)
    df = df.withColumn("LoadDate", F.current_timestamp())

    # 3. First run: create the Delta table with unique records.
    if not spark.catalog.tableExists(target_table):
        df.write.format("delta").mode("append").saveAsTable(target_table)

    else:
        # 4. Compare every source column, excluding LoadDate.
        # Null-safe equality treats NULL and NULL as matching values.
        def column_ref(alias, name):
            escaped = name.replace("`", "``")
            return F.col(f"{alias}.`{escaped}`")

        match_condition = reduce(
            lambda left, right: left & right,
            [
                column_ref("target", c).eqNullSafe(column_ref("source", c))
                for c in source_columns
            ],
        )

        # 5. Insert only rows that do not already exist.
        (
            DeltaTable.forName(spark, target_table)
            .alias("target")
            .merge(df.alias("source"), match_condition)
            .whenNotMatchedInsertAll()
            .execute()
        )

    print(f"Completed: {source_path} → {target_table}")


for source_path, target_table in SOURCE_TABLES.items():
    ingest_to_bronze(source_path, target_table)




