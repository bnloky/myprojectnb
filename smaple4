completed_tables = []

for config in source_tables:
    source_path = config["source_path"]
    target_table_name = config["target_table"]

    df_file = read_claim_files(source_path, config["delimiter"])
    write_unique_delta(df_file, target_table_name)

    completed_tables.append(target_table_name)
    print(f"[COMPLETED] {source_path} -> {target_table_name}")

print(f"Bronze load finished. Tables processed: {len(completed_tables)}")
