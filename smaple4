spark.sql("CREATE SCHEMA IF NOT EXISTS Bronze")


#############
def read_claim_files(source_path: str, delimiter: str):
    # Use Spark's delimited-text reader for both TXT and CSV extensions.
    df = (
        spark.read.format("csv")
        .option("delimiter", delimiter)
        .option("header", "true")
        .option("inferSchema", str(infer_schema).lower())
        .option("enforceSchema", "false")
        .option("pathGlobFilter", file_pattern)
        .option("mode", "FAILFAST")
        .load(source_path)
    )

    # Keep source headers; reserve LoadDate for ingestion metadata.
    if not df.columns:
        raise ValueError(f"No source columns found in {source_path}")
    if len({c.lower() for c in df.columns}) != len(df.columns):
        raise ValueError(f"Duplicate column names in {source_path}")
    if any(c.lower() == "loaddate" for c in df.columns):
        raise ValueError(f"Source already contains LoadDate: {source_path}")
    return df


def quoted_column(alias: str, name: str):
    # Quote source headers safely, including headers containing dots/backticks.
    escaped = name.replace("`", "``")
    return F.col(f"{alias}.`{escaped}`")


def write_unique_delta(df, target_table_name: str):
    source_columns = df.columns

    # Deduplicate before adding the ingestion timestamp.
    df = df.dropDuplicates(source_columns)
    df = df.withColumn("LoadDate", F.current_timestamp())

    if not spark.catalog.tableExists(target_table_name):
        # First run creates the Delta table from source columns.
        df.write.format("delta").mode("append").saveAsTable(target_table_name)
        return

    # Require stable names/types so MERGE cannot change duplicate comparison
    # through implicit type conversions. Column order may differ in the target.
    target_schema = spark.table(target_table_name).schema
    incoming_types = {f.name: f.dataType for f in df.schema.fields}
    target_types = {f.name: f.dataType for f in target_schema.fields}
    if incoming_types != target_types:
        raise ValueError(
            f"Schema mismatch for {target_table_name}. "
            "Check source headers and inferred types against the existing table."
        )

    # Match every source value, excluding the changing LoadDate timestamp.
    match_condition = reduce(
        lambda left, right: left & right,
        [quoted_column("target", c).eqNullSafe(quoted_column("source", c))
         for c in source_columns],
    )

    # Matching records remain untouched; only new records are inserted.
    (
        DeltaTable.forName(spark, target_table_name)
        .alias("target")
        .merge(df.alias("source"), match_condition)
        .whenNotMatchedInsertAll()
        .execute()
    )


