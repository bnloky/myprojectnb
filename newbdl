02 — Imports, runtime checks and shared utilities
import os, re, json, csv, time, uuid, hashlib, tempfile, traceback
from datetime import datetime, timezone, timedelta
from pathlib import PurePosixPath
from urllib.parse import urlparse
from pyspark.sql import functions as F, types as T
from delta.tables import DeltaTable
from notebookutils import mssparkutils

ALLOWED_FORMATS = {"csv", "txt", "dat", "json"}
REJECTED_FORMATS = {"xlsx", "xls", "xlsm", "dta", "pdf", "zip", "exe"}

def utcnow(): return datetime.now(timezone.utc)
def stable_hash(value): return hashlib.sha256(value.encode("utf-8")).hexdigest()
def safe_component(value):
    value = str(value or "").strip()
    if not re.fullmatch(r"[A-Za-z0-9_-]{1,100}", value):
        raise ValueError(f"Unsafe or empty path component: {value!r}")
    return value

def quote_table(table):
    parts = table.split(".")
    if len(parts) != 2 or any(not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", x) for x in parts):
        raise ValueError("Invalid schema-qualified table")
    return ".".join(f"`{x}`" for x in parts)

def with_retry(action, attempts=MAX_RETRIES):
    for attempt in range(attempts):
        try: return action()
        except Exception as exc:
            msg = str(exc).lower()
            transient = any(x in msg for x in ["concurrent", "conflict", "temporarily unavailable", "throttl"])
            if not transient or attempt == attempts - 1: raise
            time.sleep(min(2 ** attempt, 8))

def require_runtime():
    if not p_filepath or not p_client_id: raise ValueError("Pipeline must pass p_filepath and p_client_id")
    if p_serialized_by_orchestrator is not True:
        raise RuntimeError("Concurrency guard: configure real per-client/path serialization or distributed lease, then pass True")

