def configure_client(route):
    global CFG, SINGLE_FILE, SHEETS
    CFG = {**BASE_CFG, 'source':route['source_folder'], 'target':route['target_table'],
           'exception':route['exception_table'],
           'csv_sep':str(route.get('csv_delimiter', p_csv_delimiter)),
           'txt_sep':str(route.get('txt_delimiter', p_txt_delimiter)),
           'encoding':str(route.get('encoding', p_encoding)),
           'allow_multi':boolean(route.get('allow_multiple_sheets', p_allow_multiple_sheets))}
    SHEETS = route.get('sheet_names', DEFAULT_SHEETS)
    SINGLE_FILE = input_path(p_filepath, CFG['source'])
    if SINGLE_FILE and not SINGLE_FILE.startswith(CFG['source'] + '/'):
        raise ValueError('Single-file path is outside the selected client input folder')

BASE_CFG = dict(CFG)
DEFAULT_SHEETS = list(SHEETS)

def files_to_process():
    if SINGLE_FILE:
        if not mssparkutils.fs.exists(SINGLE_FILE): raise FileNotFoundError('Source file not found')
        return [SINGLE_FILE]
    if not mssparkutils.fs.exists(CFG['source']): raise FileNotFoundError('Source folder not found')
    def walk(folder):
        for item in mssparkutils.fs.ls(folder):
            if item.isDir:
                if CFG['recursive']: yield from walk(item.path)
            else:
                # Preserve relative Files path when source parameter is relative.
                yield folder.rstrip('/') + '/' + item.name
    return sorted(walk(CFG['source']))

def stage_eav(records, stage_path):
    total = 0
    iterator = iter(records)
    try:
        while True:
            batch = list(itertools.islice(iterator, CFG['batch']))
            if not batch: break
            total += len(batch)
            if total > CFG['max_cells']: raise ValueError('Per-file EAV cell limit exceeded')
            (spark.createDataFrame(batch, EAV_SCHEMA).write.mode('append')
             .parquet(stage_path))
    finally:
        close = getattr(iterator, 'close', None)
        if close: close()
    if total == 0: raise ValueError('No EAV records produced')
    return total

def exception_record(file_path, stage, exception_type):
    # Avoid persisting source row values from exception messages.
    reason = f'{exception_type}; stage={stage}; run_id={RUN_ID}. Inspect secured run diagnostics.'
    record = (file_path, file_path, reason, stage, datetime.now(timezone.utc).replace(tzinfo=None), None, 'Bronze')
    ensure_compatible_table(CFG['exception'], EXCEPTION_SCHEMA)
    (spark.createDataFrame([record], EXCEPTION_SCHEMA).write.format('delta')
     .mode('append').saveAsTable(CFG['exception']))

