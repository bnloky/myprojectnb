def process_client(route):
    configure_client(route)
    successes, failures, skipped, warnings = [], [], [], []
    try:
        ensure_compatible_table(CFG['target'], BRONZE_SCHEMA)
        ensure_compatible_table(CFG['exception'], EXCEPTION_SCHEMA)
        paths = files_to_process()
        if not paths and boolean(p_empty_folder_is_error): raise ValueError('Source folder is empty')
        for source_path in paths:
            source_path = storage_path(source_path)
            suffix = Path(source_path).suffix.lower()
            if suffix not in ALLOWED or source_path.rsplit('/', 1)[-1].startswith('~$'):
                skipped.append({'FileName': source_path, 'Status': 'SKIPPED'})
                continue
            stage_path = CFG['stage'] + '/' + RUN_ID + '/' + hashlib.sha256(source_path.encode()).hexdigest()
            stage = 'Source validation'
            try:
                # Do not parse stage/quarantine objects passed accidentally as single-file input.
                for folder in [CFG['stage'], CFG['quarantine']]:
                    if folder and (source_path == folder or source_path.startswith(folder + '/')):
                        raise ValueError('Source overlaps an output working folder')
                with tempfile.TemporaryDirectory(prefix='bronze_eav_') as temp_dir:
                    local_path = str(Path(temp_dir) / ('input' + suffix))
                    # Listing the parent lets us enforce size BEFORE copying.
                    parent, filename = source_path.rsplit('/', 1)
                    matches = [f for f in mssparkutils.fs.ls(parent) if f.name == filename and not f.isDir]
                    if len(matches) != 1: raise FileNotFoundError('Expected one source file')
                    size = int(matches[0].size)
                    limit = min(CFG['max_bytes'], CFG['max_excel']) if suffix == '.xlsx' else CFG['max_bytes']
                    if size <= 0 or size > limit: raise ValueError('Empty input or input size limit exceeded')
                    stage = 'Local snapshot copy'
                    copied = mssparkutils.fs.cp(source_path, Path(local_path).as_uri(), False)
                    if copied is False: raise IOError('Source copy failed')
                    if Path(local_path).stat().st_size != size: raise ValueError('Source changed during snapshot copy')
                    # Land completed immutable files; same-size concurrent changes cannot be detected here.
                    stage = 'Parse and stage'
                    records = excel_eav(local_path, source_path, CFG, SHEETS) if suffix == '.xlsx' else csv_eav(local_path, source_path, CFG)
                    cell_count = stage_eav(records, stage_path)
                    stage = 'Bronze write'
                    staged = spark.read.schema(EAV_SCHEMA).parquet(stage_path)
                    loaded_at = datetime.now(timezone.utc).replace(tzinfo=None)
                    output = bronze_projection(staged, CFG['engine'], loaded_at)
                    replace_file_slice(output, source_path)
                    successes.append({'FileName': source_path, 'FilePath': source_path,
                                      'Layer': 'Bronze', 'Status': 'SUCCESS', 'EAVCells': cell_count})
            except Exception as exc:
                entry = {'FileName': source_path, 'Layer': 'Bronze', 'Status': 'FAILED',
                         'FailedStage': stage, 'ExceptionType': type(exc).__name__}
                if type(exc) is ValueError:
                    entry['ExceptionReason'] = str(exc)  # loader's validation messages contain no row values
                failures.append(entry)
                try: exception_record(source_path, stage, type(exc).__name__)
                except Exception as log_error:
                    entry['ExceptionLogError'] = type(log_error).__name__
                if CFG['quarantine'] and stage in {'Source validation', 'Parse and stage'}:
                    try:
                        # Unique per-run file avoids overwriting existing failed-file copies.
                        folder = CFG['quarantine'] + '/' + RUN_ID
                        mssparkutils.fs.mkdirs(folder)
                        target = folder + '/' + hashlib.sha256(source_path.encode()).hexdigest() + suffix
                        if mssparkutils.fs.cp(source_path, target, False) is False: raise IOError('Quarantine copy failed')
                        entry['QuarantineCopy'] = target
                    except Exception as quarantine_error:
                        entry['QuarantineCopyError'] = type(quarantine_error).__name__
            finally:
                try:
                    if mssparkutils.fs.exists(stage_path):
                        if mssparkutils.fs.rm(stage_path, True) is False: raise IOError('Staging cleanup failed')
                except Exception as cleanup_error:
                    warnings.append({'Stage': 'Cleanup', 'RunId': RUN_ID, 'Type': type(cleanup_error).__name__})
        if not successes and not failures:
            if boolean(p_empty_folder_is_error):
                failures.append({'Layer': 'Bronze', 'Status': 'FAILED', 'ExceptionReason': 'No supported files found'})
            else:
                warnings.append({'Status': 'NO_INPUT', 'SourceFolder': CFG['source']})
        if successes and boolean(p_run_optimize):
            try: spark.sql('OPTIMIZE ' + table_id(CFG['target']))
            except Exception as optimize_error:
                failures.append({'Layer':'Bronze', 'Status':'FAILED', 'FailedStage':'OPTIMIZE',
                                 'ExceptionType': type(optimize_error).__name__})
    except Exception as setup_error:
        failures.append({'Layer': 'Bronze', 'Status': 'FAILED', 'FailedStage': 'Setup',
                         'ExceptionType': type(setup_error).__name__})
    for entries in [successes, failures, skipped, warnings]:
        for entry in entries:
            entry['Client'] = route['client']
            entry['TargetTable'] = route['target_table']
    return successes, failures, skipped, warnings

all_successes, all_failures, all_skipped, all_warnings = [], [], [], []
for route in ROUTES:
    try:
        successes, failures, skipped, warnings = process_client(route)
        all_successes.extend(successes); all_failures.extend(failures)
        all_skipped.extend(skipped); all_warnings.extend(warnings)
    except Exception as route_error:
        all_failures.append({'Client':route['client'], 'TargetTable':route['target_table'],
                             'Status':'FAILED', 'FailedStage':'Client setup',
                             'ExceptionType':type(route_error).__name__})
if not all_successes and not all_failures:
    all_failures.append({'Status':'FAILED', 'ExceptionReason':'No supported files were ingested from selected clients'})
result = {'exit_value':bool(all_successes) and not all_failures,
          'exit_message':all_successes + all_failures, 'skipped':all_skipped,
          'warnings':all_warnings, 'run_id':RUN_ID}
print(json.dumps(result, default=str))


