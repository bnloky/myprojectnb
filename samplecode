import csv, json, re, hashlib, tempfile, itertools
from pathlib import Path
from datetime import date, datetime, timezone
import openpyxl
from notebookutils import mssparkutils
from pyspark.sql import functions as F
from pyspark.sql.types import StructType, StructField, StringType, LongType, TimestampType

RUN_ID = __import__('uuid').uuid4().hex
ALLOWED = {'.csv', '.txt', '.xlsx'}

def boolean(value):
    if isinstance(value, bool): return value
    if str(value).strip().lower() in {'true', '1'}: return True
    if str(value).strip().lower() in {'false', '0'}: return False
    raise ValueError('Boolean parameter must be true or false')

def integer(value, minimum=0):
    number = int(value)
    if number < minimum: raise ValueError('Numeric parameter out of range')
    return number

def table_id(name):
    parts = str(name).split('.')
    if not 1 <= len(parts) <= 3 or any(not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', p) for p in parts):
        raise ValueError('Use one to three simple table identifier components')
    return '.'.join('`' + p + '`' for p in parts)

def storage_path(value):
    path = str(value).strip().replace('\\', '/')
    if path.startswith('/lakehouse/default/'):
        path = path[len('/lakehouse/default/'):]
    if not (path.startswith('Files/') or path.startswith('abfss://')):
        raise ValueError('Use Files/... or an explicit ABFSS path')
    if any(p in {'.', '..'} for p in path.split('/')):
        raise ValueError('Relative traversal segments are not allowed')
    return path.rstrip('/')

def input_path(value, folder):
    if value is None or not str(value).strip(): return None
    decoded = value
    for _ in range(2):
        if not isinstance(decoded, str): break
        try: decoded = json.loads(decoded)
        except (ValueError, TypeError): break
    if isinstance(decoded, dict):
        paths = [decoded[k] for k in ('path','file_path','p_filepath') if k in decoded]
        if len(paths) != 1: raise ValueError('JSON must contain exactly one supported path key')
        decoded = paths[0]
    if not isinstance(decoded, str) or not decoded.strip(): raise ValueError('Invalid input path')
    decoded = decoded.strip().replace('\\', '/')
    if decoded.startswith(('Files/', 'abfss://', '/lakehouse/default/')):
        return storage_path(decoded)
    return storage_path(folder + '/' + decoded)

def validate_routes(raw, selected_client):
    routes = json.loads(raw) if isinstance(raw, str) else raw
    if not isinstance(routes, list) or not routes: raise ValueError('Routes must be a nonempty JSON list')
    clients, folders, destinations, exceptions, normalized = set(), [], set(), set(), []
    for item in routes:
        if not isinstance(item, dict): raise ValueError('Every route must be a JSON object')
        client = str(item.get('client', '')).strip().upper()
        if client not in {'CBG', 'AMPS'}: raise ValueError('Client must be CBG or AMPS')
        if client in clients: raise ValueError('Duplicate client route')
        clients.add(client)
        folder = storage_path(item['source_folder'])
        if any(folder == other or folder.startswith(other + '/') or other.startswith(folder + '/') for other in folders):
            raise ValueError('Client input folders must be distinct and non-overlapping')
        folders.append(folder)
        target = str(item['target_table']); exception = str(item['exception_table'])
        table_id(target); table_id(exception)
        if target.lower() in destinations: raise ValueError('Each client must have its own Bronze table')
        if exception.lower() in exceptions: raise ValueError('Each client must have its own exception table')
        destinations.add(target.lower()); exceptions.add(exception.lower())
        for key in ('csv_delimiter', 'txt_delimiter'):
            if key in item and len(str(item[key])) != 1: raise ValueError('Use single-character delimiters')
        if 'sheet_names' in item:
            sheets = item['sheet_names']
            if not isinstance(sheets, list) or any(not isinstance(x, str) for x in sheets) or len(sheets) != len(set(sheets)):
                raise ValueError('Route sheet_names must be a unique string list')
        normalized.append({**item, 'client':client, 'source_folder':folder,
                           'target_table':target, 'exception_table':exception})
    if destinations & exceptions: raise ValueError('Bronze and exception tables must not overlap')
    chosen = str(selected_client).strip().upper()
    if chosen == 'ALL': return normalized
    selected = [r for r in normalized if r['client'] == chosen]
    if not selected: raise ValueError('Selected client has no configured route')
    return selected

ALL_ROUTES = validate_routes(p_routes_json, 'ALL')
ROUTES = validate_routes(p_routes_json, p_client)
if str(p_filepath).strip() and str(p_client).strip().upper() == 'ALL':
    raise ValueError('For a single file, explicitly select CBG or AMPS')
# Initialize helper configuration; the execution cell overrides it for each route.
p_source_folder = ROUTES[0]['source_folder']
p_target_table = ROUTES[0]['target_table']
p_exception_table = ROUTES[0]['exception_table']

# Typed config is evaluated after Fabric injects pipeline parameters.
CFG = {
    'source': storage_path(p_source_folder), 'stage': storage_path(p_staging_folder),
    'target': str(p_target_table), 'exception': str(p_exception_table),
    'recursive': boolean(p_recursive), 'allow_multi': boolean(p_allow_multiple_sheets),
    'blank_headers': boolean(p_allow_blank_headers), 'pad_short': boolean(p_pad_short_rows),
    'header_row': integer(p_header_row), 'batch': integer(p_batch_cells, 1),
    'max_cells': integer(p_max_eav_cells, 1),
    'max_bytes': integer(p_max_input_bytes, 1), 'max_excel': integer(p_max_excel_bytes, 1),
    'csv_sep': str(p_csv_delimiter), 'txt_sep': str(p_txt_delimiter),
    'encoding': str(p_encoding), 'engine': str(p_transform_engine).lower(),
    'quarantine': storage_path(p_quarantine_folder) if str(p_quarantine_folder).strip() else None,
}
table_id(CFG['target']); table_id(CFG['exception'])
if CFG['target'].lower() == CFG['exception'].lower(): raise ValueError('Target and exception table must differ')
if CFG['engine'] not in {'pyspark', 'spark_sql'}: raise ValueError('Unknown transformation engine')
if len(CFG['csv_sep']) != 1 or len(CFG['txt_sep']) != 1: raise ValueError('Use a single-character delimiter')
for output in [CFG['stage'], CFG['quarantine']]:
    if output and (output == CFG['source'] or output.startswith(CFG['source'] + '/')):
        raise ValueError('Staging/quarantine folder cannot be inside the intake folder')
SHEETS = json.loads(p_sheet_names_json) if isinstance(p_sheet_names_json, str) else p_sheet_names_json
if not isinstance(SHEETS, list) or any(not isinstance(s, str) for s in SHEETS) or len(set(SHEETS)) != len(SHEETS):
    raise ValueError('p_sheet_names_json must be a list of unique sheet names')
SINGLE_FILE = input_path(p_filepath, CFG['source'])

# Validate working folders against every route before any data writes.
for route in ALL_ROUTES:
    for output in [CFG['stage'], CFG['quarantine']]:
        if output and (output == route['source_folder'] or output.startswith(route['source_folder'] + '/')):
            raise ValueError('Staging/quarantine folder cannot be inside any intake folder')


