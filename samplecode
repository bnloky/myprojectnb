if not result['exit_value'] and boolean(p_fail_on_error):
    raise RuntimeError('Bronze ingestion failed; inspect the printed run metadata and exception table')
if boolean(p_return_json):
    mssparkutils.notebook.exit(json.dumps(result, default=str))

