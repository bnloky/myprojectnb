EAV_SCHEMA = StructType([
    StructField('FileName', StringType(), True),
    StructField('SheetName', StringType(), True),
    StructField('ColumnPlaceholder', StringType(), True),
    StructField('RawColumnName', StringType(), True),
    StructField('ColumnDataType', StringType(), True),
    StructField('Value', StringType(), True),
    StructField('RowNumber', LongType(), True),
])
BRONZE_SCHEMA = StructType(EAV_SCHEMA.fields + [StructField('LoadDate', TimestampType(), True)])
EXCEPTION_SCHEMA = StructType([
    StructField('FileName', StringType(), True), StructField('FilePath', StringType(), True),
    StructField('ExceptionReason', StringType(), True), StructField('FailedStage', StringType(), True),
    StructField('LoggedDate', TimestampType(), True), StructField('FieldName', StringType(), True),
    StructField('Layer', StringType(), True),
])

def ensure_compatible_table(name, schema):
    if not spark.catalog.tableExists(name): return
    actual = {f.name.lower(): f.dataType.simpleString() for f in spark.table(name).schema.fields}
    expected = {f.name.lower(): f.dataType.simpleString() for f in schema.fields}
    if actual != expected:
        raise ValueError('Destination schema mismatch; use a compatible EAV/exception table')

def observed_type(value):
    if value is None or value == '': return 'Null'
    if isinstance(value, bool): return 'Boolean'
    if isinstance(value, int): return 'Integer'
    if isinstance(value, float): return 'Float'
    if isinstance(value, (datetime, date)): return 'Timestamp'
    return 'String'

def header_names(values, allow_blank=False):
    headers = []
    for index, value in enumerate(values, 1):
        if value is None or not str(value).strip():
            if not allow_blank: raise ValueError('Blank header: verify row and terminal delimiter')
            headers.append(f'Column_{index}')
        else:
            headers.append(str(value))  # preserve spelling/case/spaces; position distinguishes duplicates
    if not headers: raise ValueError('No header fields')
    return headers

def nonblank(values):
    return bool(values) and any(v is not None and str(v).strip() for v in values)

def rows_as_eav(rows, file_path, sheet_name, cfg):
    headers, data_row = None, 0
    for physical_index, row in enumerate(rows):
        if physical_index < cfg['header_row']: continue
        row = list(row)
        if not nonblank(row): continue
        if headers is None:
            headers = header_names(row, cfg['blank_headers'])
            if len(headers) < 2:
                raise ValueError('One field detected; verify delimiter or adapt for valid single-field input')
            continue
        if len(row) > len(headers): raise ValueError('Row has more values than headers')
        if len(row) < len(headers):
            if not cfg['pad_short']: raise ValueError('Row has fewer values than headers')
            row += [None] * (len(headers) - len(row))
        data_row += 1
        for column_index, (name, value) in enumerate(zip(headers, row), 1):
            yield (file_path, sheet_name, f'C{column_index}', name, observed_type(value),
                   None if value is None else str(value), int(data_row))
    if headers is None: raise ValueError('Empty file or sheet')
    if data_row == 0: raise ValueError('Header-only file or sheet')

def csv_eav(local_path, file_path, cfg):
    sep = cfg['txt_sep'] if Path(local_path).suffix.lower() == '.txt' else cfg['csv_sep']
    csv.field_size_limit(16 * 1024 * 1024)
    with open(local_path, 'r', encoding=cfg['encoding'], newline='') as stream:
        rows = csv.reader(stream, delimiter=sep, quotechar='"', doublequote=True, strict=True)
        yield from rows_as_eav(rows, file_path, 'CSV_DEFAULT', cfg)

def excel_eav(local_path, file_path, cfg, selected_sheets):
    workbook = openpyxl.load_workbook(local_path, read_only=True, data_only=True)
    try:
        names = selected_sheets or list(workbook.sheetnames)
        if not names or any(name not in workbook.sheetnames for name in names):
            raise ValueError('Selected worksheet does not exist')
        if len(names) > 1 and not cfg['allow_multi']:
            raise ValueError('Select one worksheet or allow multiple sheets')
        for name in names:
            yield from rows_as_eav(workbook[name].iter_rows(values_only=True), file_path, name, cfg)
    finally:
        workbook.close()

