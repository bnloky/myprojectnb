def bronze_projection(stage_df, engine, loaded_at):
    if engine == 'pyspark':
        return stage_df.select(
            F.col('FileName'), F.col('SheetName'), F.col('ColumnPlaceholder'),
            F.col('RawColumnName'), F.col('ColumnDataType'), F.col('Value'),
            F.col('RowNumber').cast('long').alias('RowNumber'),
            F.lit(loaded_at).cast('timestamp').alias('LoadDate'))
    stage_df.createOrReplaceTempView('_bronze_eav_stage')
    spark.createDataFrame([(loaded_at,)], 'LoadDate timestamp').createOrReplaceTempView('_bronze_eav_load_time')
    return spark.sql("""
        SELECT s.FileName, s.SheetName, s.ColumnPlaceholder, s.RawColumnName,
               s.ColumnDataType, s.Value, CAST(s.RowNumber AS BIGINT) AS RowNumber,
               t.LoadDate
        FROM _bronze_eav_stage s CROSS JOIN _bronze_eav_load_time t
    """)

def replace_file_slice(df, file_path):
    ensure_compatible_table(CFG['target'], BRONZE_SCHEMA)
    writer = df.write.format('delta')
    if spark.catalog.tableExists(CFG['target']):
        # UTF-8 hex avoids inserting untrusted path characters into predicate SQL.
        encoded = file_path.encode('utf-8').hex()
        predicate = f"FileName = CAST(unhex('{encoded}') AS STRING)"
        writer.mode('overwrite').option('replaceWhere', predicate).saveAsTable(CFG['target'])
    else:
        writer.mode('errorifexists').saveAsTable(CFG['target'])


