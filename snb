def exception_exit_message(file_names, fallback):
    if not ENABLE_WRITES or not file_names or not spark.catalog.tableExists(TBL_EXCEPTIONS):
        return fallback
    exceptions = spark.table(TBL_EXCEPTIONS).filter(F.col("FileName").isin(list(file_names)))
    preferred = exceptions.filter(F.col("FailedStage") != "Silver Exclusions")
    rows = preferred.orderBy(F.col("LoggedDate").desc()).limit(1).collect()
    if not rows:
        rows = exceptions.orderBy(F.col("LoggedDate").desc()).limit(1).collect()
    if not rows:
        return fallback
    output = rows[0].asDict()
    output["ExceptionReason"] = str(output.get("ExceptionReason", ""))[:400]
    return [output]


def check_configuration():
    if not CONFIGURATION_VERIFIED:
        raise RuntimeError("Verify tables, metadata columns, prompt IDs, source keys, DQ rules and AI_RUNNER; then set CONFIGURATION_VERIFIED=True")
    if AI_RUNNER is None or not callable(AI_RUNNER):
        raise RuntimeError("Missing AI_RUNNER")
    if ENABLE_WRITES:
        for name in [TBL_AUDIT, TBL_STEWARD, TBL_SILVER, TBL_PROCESSED, TBL_EXCEPTIONS]:
            if not spark.catalog.tableExists(name):
                raise ValueError(f"Missing destination table: {name}")


def process_silver():
    check_configuration()
    context = parse_input_path(p_filepath)
    file_name = context["file_name"]
    intermediates = []
    try:
        prompts = load_prompts()
        raw = load_bronze(file_name); intermediates.append(raw)
        lineage = normalize_headers(raw, prompts["normalization"], file_name); intermediates.append(lineage)
        inc, exc = load_reference_patterns()
        candidates = quality_and_exclusions(lineage, inc, exc, file_name); intermediates.append(candidates)
        deterministic, remaining = deterministic_matching(candidates, inc)
        intermediates.extend([deterministic, remaining])
        audit_matches(deterministic, "DETERMINISTIC_INC", "DETERMINISTIC")
        pos_ctx = "\n".join(f"{r.NormalisedInclusion}: target={r.ReferenceName}" for r in inc.collect())
        neg_ctx = "\n".join(r.NormalisedExclusion for r in exc.collect())
        semantic = semantic_matching(remaining, prompts["phase1"], pos_ctx, neg_ctx, file_name)
        intermediates.append(semantic)
        combined = deterministic.unionByName(semantic).distinct().cache(); intermediates.append(combined)
        resolved = conflict_and_contract(combined, candidates, prompts, pos_ctx, neg_ctx, file_name)
        intermediates.append(resolved)
        final = pivot_and_check(raw, resolved, file_name); intermediates.append(final)
        log_processed(final, context)
        return {"exit_value": True, "exit_message": "Successful" if ENABLE_WRITES else "Preview successful; no tables written"}
    except Exception as error:
        if file_name not in quarantined_files:
            quarantined_files.add(file_name)
            try:
                log_and_quarantine(file_name, "Silver Processing", str(error))
            except Exception as logging_error:
                return {"exit_value": False, "exit_message": str(error), "logging_error": str(logging_error)}
        return {"exit_value": False,
                "exit_message": exception_exit_message(quarantined_files, str(error))}
    finally:
        for frame in intermediates:
            try:
                frame.unpersist()
            except Exception:
                pass


quarantined_files = set()
if RUN_PIPELINE:
    # exit outside try, so its control-flow signal is not swallowed.
    try:
        result = process_silver()
    except Exception as error:
        result = {"exit_value": False, "exit_message": str(error)}
    print(json.dumps(result, default=str))
    from notebookutils import mssparkutils
    mssparkutils.notebook.exit(json.dumps(result, default=str))
else:
    print("Review mode: notebook definitions loaded; pipeline execution disabled")



