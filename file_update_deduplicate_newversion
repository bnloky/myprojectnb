import hashlib
from pyspark.sql import functions as F

CONTROL_TABLE = "Metadata.tbl_FileProcessingControl"

def calculate_sha256(local_file_path):
    sha256 = hashlib.sha256()

    with open(local_file_path, "rb") as f:
        for chunk in iter(
            lambda: f.read(1024 * 1024), b""
        ):
            sha256.update(chunk)

    return sha256.hexdigest()


def check_file_version(source_path, content_hash):
    history = (
        spark.table(CONTROL_TABLE)
        .filter(F.col("SourcePath") == source_path)
        .filter(F.col("ProcessingStatus") == "SUCCESS")
    )

    duplicate = (
        history
        .filter(F.col("ContentHash") == content_hash)
        .limit(1)
        .count() > 0
    )

    if duplicate:
        return "SKIP_DUPLICATE"

    if history.limit(1).count() > 0:
        return "PROCESS_UPDATED_VERSION"

    return "PROCESS_NEW_FILE"


## Explanation
calculate_sha256() calculates a checksum from the file's actual bytes.

check_file_version() searches the Delta control table for previously successful versions of the same source path.

If the content hash already exists, it returns SKIP_DUPLICATE.

If the source path exists but the hash is different, it returns PROCESS_UPDATED_VERSION.

If no previous successful version exists, it returns PROCESS_NEW_FILE.

This example assumes you have already created Metadata.tbl_FileProcessingControl with the required columns. It is detection logic, not a complete concurrency-safe processing framework.

