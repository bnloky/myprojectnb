spark.conf.set("spark.sql.session.timeZone", "UTC")

def utc_now():
    return datetime.now(timezone.utc).replace(tzinfo=None)

def safe_component(value):
    v = str(value).strip()
    if not re.fullmatch(r"[A-Za-z0-9_-]{1,80}", v):
        raise ValueError("Client ID must contain only letters, numbers, underscore or hyphen")
    return v

def normalized_path(path):
    p = str(path or "").strip()
    if not p or ".." in p.replace("\\", "/").split("/"):
        raise ValueError("Invalid or missing p_filepath")
    if not (p.startswith("Files/") or p.startswith("abfss://")):
        raise ValueError("Provide a Lakehouse Files path or an abfss:// path")
    return p

def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()

def deterministic_id(*values):
    return hashlib.sha256(json.dumps(values, separators=(",", ":"), ensure_ascii=False).encode()).hexdigest()

def event_time(value):
    if not str(value).strip():
        return utc_now()
    dt = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    if dt.tzinfo is None:
        raise ValueError("p_effective_at must include a timezone, e.g. +00:00 or Z")
    return dt.astimezone(timezone.utc).replace(tzinfo=None)

