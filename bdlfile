
##Pipeline parameters and configuration
# Fabric parameter cell
p_filepath = ""                 # Example: Files/landing/CBG/2026-11-10/claims.csv
p_client_id = ""                # Example: CBG or AMPS
p_source_version = ""           # Optional: blob version ID / ETag for audit
p_delimiter = "auto"            # auto, comma, pipe, tab, semicolon
p_encoding = "utf-8-sig"
p_effective_at = ""             # Optional ISO 8601 UTC event time; blank = processing UTC time
p_max_file_mb = 200             # Driver-based parsing safety limit; tune to capacity
p_debug = True

BRONZE_TABLE = "Bronze.tbl_ClaimsRawDataVersioned"
CONTROL_TABLE = "Metadata.tbl_FileProcessingControl"
EXCEPTION_TABLE = "Metadata.tbl_FileExceptions"
ARCHIVE_ROOT = "Files/LH_gpo/ReceivedVersioned"
QUARANTINE_ROOT = "Files/LH_gpo/Exceptions"


##Imports and helper utilities
import csv, hashlib, json, os, re, tempfile, shutil, uuid
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import urlsplit
