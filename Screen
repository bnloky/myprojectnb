# NB_SPIKE_CBG_Landing_To_Bronze
# Goal: one client file -> one bronze Delta table, ALL COLUMNS AS STRING

from pyspark.sql import functions as F

# --- CONFIG (hardcoded for spike only) ---
LANDING_PATH = "Files/Landing_zone/CBG_Claims"   # confirm exact folder/file in Lakehouse
FILE_FORMAT = "csv"                              # csv | txt | dat — confirm
DELIMITER = "|"                                  # confirm: | , \t etc.
HAS_HEADER = True
BRONZE_SCHEMA = "bronze"
BRONZE_TABLE = "cbg_claims_raw"                  # client-based name; change if naming standard differs
TARGET = f"{BRONZE_SCHEMA}.{BRONZE_TABLE}"

# --- 1) Discover files ---
files = spark.createDataFrame(
    mssparkutils.fs.ls(LANDING_PATH)
).select("name", "path", "size", "modifyTime")
display(files)

# Pick the first data file (refine filter once you see real names)
file_rows = [r for r in mssparkutils.fs.ls(LANDING_PATH) if not r.isDir]
assert file_rows, f"No files under {LANDING_PATH}"
SOURCE_FILE = file_rows[0].path
print("Using:", SOURCE_FILE)

# --- 2) Read EVERYTHING as string (no type inference) ---
# inferSchema=False + all StringType preserves leading zeros, decimals, large numbers as text
reader = (
    spark.read
    .option("header", str(HAS_HEADER).lower())
    .option("delimiter", DELIMITER)
    .option("quote", '"')
    .option("escape", '"')
    .option("multiLine", "false")
    .option("mode", "PERMISSIVE")
    .option("inferSchema", "false")   # critical
)

df_raw = reader.csv(SOURCE_FILE)

# Force every column to string explicitly (extra safety)
for c in df_raw.columns:
    df_raw = df_raw.withColumn(c, F.col(c).cast("string"))

# Technical columns (do not replace source values)
df_bronze = (
    df_raw
    .withColumn("_source_path", F.lit(SOURCE_FILE))
    .withColumn("_ingestion_ts", F.current_timestamp())
    .withColumn("_client_code", F.lit("CBG"))
)

print("Columns:", df_bronze.columns)
print("Row count:", df_bronze.count())
display(df_bronze.limit(10))

# --- 3) Write Bronze Delta (overwrite OK for spike) ---
spark.sql(f"CREATE SCHEMA IF NOT EXISTS {BRONZE_SCHEMA}")

(
    df_bronze.write
    .format("delta")
    .mode("overwrite")          # spike only; later use append + file control
    .option("overwriteSchema", "true")
    .saveAsTable(TARGET)
)

# --- 4) Quick verify ---
bronze = spark.table(TARGET)
print("Bronze rows:", bronze.count())
display(bronze.limit(10))

