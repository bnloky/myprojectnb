def align_and_write_delta(df, target_table_name: str, max_retries: int = 3,
                          retry_delay_sec: int = 2):
    try:
        if spark.catalog.tableExists(target_table_name):
            target_schema = spark.table(target_table_name).schema
            source_cols = {col.lower(): col for col in df.columns}
            if len(source_cols) != len(df.columns):
                raise ValueError("Source contains case-insensitive duplicate columns")
            select_exprs = []
            for field in target_schema.fields:
                actual = source_cols.get(field.name.lower())
                if actual is not None:
                    escaped = actual.replace("`", "``")
                    select_exprs.append(F.col(f"`{escaped}`").cast(field.dataType).alias(field.name))
                elif field.nullable:
                    select_exprs.append(F.lit(None).cast(field.dataType).alias(field.name))
                else:
                    raise ValueError(f"Non-nullable target column '{field.name}' is missing")
            # RECONSTRUCTED: prevent accidental loss of new metadata columns.
            target_cols = {f.name.lower() for f in target_schema.fields}
            extra = set(source_cols) - target_cols
            if extra:
                raise ValueError(f"Target schema is missing source columns: {sorted(extra)}")
            aligned_df = df.select(*select_exprs)
        else:
            aligned_df = df
    except Exception as align_err:
        raise ValueError(f"Schema resolution failure for table '{target_table_name}': {align_err}") from align_err
    if max_retries < 1:
        raise ValueError("max_retries must be at least 1")
    for attempt in range(max_retries):
        try:
            aligned_df.write.format("delta").mode("append").saveAsTable(target_table_name)
            return
        except Exception as write_err:
            text = str(write_err).lower()
            conflict = any(x in text for x in (
                "concurrentappendexception", "concurrentwriteexception",
                "concurrentdelete", "metadatachangedexception", "protocolchangedexception"
            ))
            if not conflict or attempt == max_retries - 1:
                raise
            time.sleep(retry_delay_sec * (attempt + 1))



def resolve_input_path(value):
    if value is None or not str(value).strip() or str(value).strip().lower() == "null":
        raise ValueError("Parameter 'p_filepath' is null, empty, or not received.")
    parsed = value
    for _ in range(2):
        if not isinstance(parsed, str):
            break
        try:
            parsed = json.loads(parsed.strip())
        except (json.JSONDecodeError, ValueError):
            break
    if isinstance(parsed, dict):
        values = [v for v in parsed.values() if isinstance(v, str)
                  and "requests/received" in v.replace("\\", "/").lower()]
        if len(values) != 1:
            raise ValueError("JSON must contain exactly one requests/received path value")
        candidate_path = values[0]
    elif isinstance(parsed, str):
        candidate_path = parsed
    else:
        raise ValueError("Expected a path string or JSON object")
    candidate_path = candidate_path.strip().replace("\\", "/")
    pattern = r"(?:^|/)requests/received/(?P<date>\d{4}-\d{2}-\d{2})/(?P<org_id>[^/]+)/(?P<file_name>[^/]+)$"
    match = re.search(pattern, candidate_path, re.IGNORECASE)
    if not match:
        raise ValueError(f"Path structure does not match expected pattern: {candidate_path}")
    extracted_date, extracted_org_id, file_name = (
        match.group("date"), match.group("org_id"), match.group("file_name")
    )
    datetime.strptime(extracted_date, "%Y-%m-%d")
    if extracted_org_id in (".", "..") or file_name in (".", ".."):
        raise ValueError("Invalid relative path segment")
    if not file_name.lower().endswith((".xlsx", ".csv", ".txt")):
        raise ValueError(f"Unsupported file extension: {file_name}")
    return extracted_date, extracted_org_id, file_name

